          "main_title": "CRAFTED FOR\u2028COMFORT",
          "author": "Elite Pods",
          "language": "en",
          "level": 2,
          "primary_content": [
           {
            "text": "From the ground up, we bring your vision to life.",
            "url": null,
            "urls": null
           },
           {
            "text": "We custom-build premium entertainment pods, handling every detail, starting with the concrete slab, through to crane lifting, plumbing and electrical, all the way to decking, full installation and final finish.",
